# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
.env
.env.*
**/.env

# typescript
*.tsbuildinfo

# uploaded node firmware images (server/services/firmwareUpdate.js) — build
# artifacts pushed via the Console, not source
source_code/server/firmware/*.bin

# real WiFi credentials for the dial (server/rs485-nodes/dial_node.ino) —
# secrets.h.example is the committed template, this exact file is not
source_code/server/rs485-nodes/secrets.h
